{
  "schemaVersion": "1.0",
  "blenderPath": "/path/to/blender",
  "renderScriptPath": "/path/to/QualCompare/obj2png/render_single.py",
  "inputDir": "/path/to/WPC",
  "outputDir": "/path/to/output/WPC_8v_yfixed",
  "objType": "ply",
  "fileType": "everything",
  "positionsType": "yfixed",
