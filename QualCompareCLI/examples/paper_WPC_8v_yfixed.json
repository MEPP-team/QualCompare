    "filterSize": 1.5,
    "maskThreshold": 10,
    "sunEnergy": 5.0,
    "sunTheta": 30.0,
    "sunPhi": 50.0,
    "bgColor": "#34322C"
  },
  "ply": {
    "mode": "sphere",
    "pointRadiusFraction": 0.001,
    "voxelBits": 10,
    "voxelRadiusMultiplier": 1.0
  },
  "maxParallelism": 0,
  "prefetchToSSD": true
